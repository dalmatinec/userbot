# Данные приложения Telegram (те же, что у первого бота — это нормально)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Токен обычного бота-админки от @BotFather (новый бот, не тот, что пересылает заявки)
BOT_TOKEN=123456:ABC-DEF

# Telegram ID главных админов через запятую (их нельзя удалить из админки)
ADMIN_IDS=111111111

# Сессия юзербота: имя файла в папке data/ ИЛИ строковая сессия (StringSession).
# ВАЖНО: нужна СВОЯ сессия, не файл сессии первого бота — создайте её через `python login.py`.
SESSION=userbot

# Папка для базы данных, сессии и медиа шаблонов
DATA_DIR=data

# Уровень логов: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
