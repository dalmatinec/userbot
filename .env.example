# Данные приложения Telegram (my.telegram.org)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Сессия: имя файла в папке DATA_DIR ИЛИ строковая сессия (StringSession)
SESSION=userbot

# Папка с файлом сессии
DATA_DIR=data

# Минимальное значение кубика (5 → только 5 или 6) и максимум бросков за команду
DICE_MIN=5
DICE_MAX_ROLLS=10

LOG_LEVEL=INFO
